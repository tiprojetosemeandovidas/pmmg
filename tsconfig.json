{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": false,
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "lib": ["ES2022", "DOM"],
    "types": ["node"],
    "skipLibCheck": true
  },
  "include": ["api/**/*.js", "lib/**/*.js", "tests/**/*.js", "scripts/validate-build.js"],
  "exclude": ["node_modules", "public/data"]
}
